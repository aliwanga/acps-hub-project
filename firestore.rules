rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An administrator is anyone whose user ID has a document in the "admins" collection.
    // That collection can only be edited from the Firebase console, never from the app.
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Each signed-in user can read and write ONLY their own document.
    // Administrators can READ every user document (read-only, cannot change anything).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Lets the app check whether the signed-in user is an admin. Nobody can write here from the app.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }
  }
}
